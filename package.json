{
"name": "zklizlauncher1.0",
"productName": "LONGVEK LAUNCHER",
"version": "1.0.7",
"description": "កម្មវិធីបើកលេង Minecraft កម្ពុជា - LONGVEK LAUNCHER",
"main": "main.js",
"scripts": {
"start": "electron .",
"build": "electron-builder --win --x64",
"dist": "electron-builder"
},
"keywords": [
"minecraft",
"launcher",
"longvek",
"cambodia"
],
"author": "LONGVEK Team",
"license": "ISC",
"type": "commonjs",
"dependencies": {
"axios": "^1.19.0",
"discord-rpc": "^4.0.1",
"electron-updater": "^6.8.9",
"extract-zip": "^2.0.1",
"minecraft-launcher-core": "^3.18.2",
"msmc": "^3.1.5"
},
"devDependencies": {
"electron": "^31.7.7",
"electron-builder": "^24.13.3"
},
"build": {
"appId": "com.longvek.launcher",
"productName": "LONGVEK LAUNCHER",
"files": [
"main.js",
"preload.js",
"index.html",
"LONGVEKLAUNCHER.ico",
"package.json"
],
"publish": [
{
"provider": "github",
"owner": "zarxmcofficial",
"repo": "longveklauncher"
}
],
"directories": {
"output": "dist"
},
"win": {
"target": "nsis",
"icon": "LONGVEKLAUNCHER.ico"
},
"nsis": {
"oneClick": false,
"perMachine": false,
"allowToChangeInstallationDirectory": true,
"installerIcon": "LONGVEKLAUNCHER.ico",
"uninstallerIcon": "LONGVEKLAUNCHER.ico",
"installerHeaderIcon": "LONGVEKLAUNCHER.ico",
"createDesktopShortcut": true,
"createStartMenuShortcut": true,
"shortcutName": "LONGVEK LAUNCHER",
"artifactName": "LONGVEK-LAUNCHER-Setup-${version}.${ext}"
}
}
}