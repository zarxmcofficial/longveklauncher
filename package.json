{
"name": "zklizlauncher3.0",
"productName": "LONGVEKMC Launcher",
"version": "1.0.0",
"description": "កម្មវិធីបើកលេង Minecraft កម្ពុជា - LONGVEKMC Launcher",
"main": "main.js",
"scripts": {
"start": "electron .",
"build": "electron-builder --win --x64",
"dist": "electron-builder"
},
"keywords": [
"minecraft",
"launcher",
"longvekmc",
"cambodia"
],
"author": "LONGVEKMC Team",
"license": "ISC",
"type": "commonjs",
"dependencies": {
"axios": "^1.19.0",
"discord-rpc": "^4.0.1",
"electron-updater": "^6.8.9",
"extract-zip": "^2.0.1",
"minecraft-launcher-core": "^3.18.2",
"msmc": "^3.1.5"
},
"devDependencies": {
"electron": "^31.7.7",
"electron-builder": "^24.13.3"
},
"build": {
"appId": "com.longvekmc.launcher",
"productName": "LONGVEKMC Launcher",
"publish": [
{
"provider": "github",
"owner": "YOUR_GITHUB_USERNAME",
"repo": "YOUR_REPO_NAME"
}
],
"directories": {
"output": "dist"
},
"win": {
"target": [
"nsis",
"portable"
],
"icon": "icon.ico"
},
"nsis": {
"oneClick": false,
"allowToChangeInstallationDirectory": true,
"installerIcon": "icon.ico",
"uninstallerIcon": "icon.ico",
"installerHeaderIcon": "icon.ico",
"createDesktopShortcut": true,
"createStartMenuShortcut": true,
"shortcutName": "LONGVEKMC Launcher"
}
}
}