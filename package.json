{
"name": "zklizlauncher1.0",
"productName": "LONGVEK LAUNCHER",
"version": "1.1.1",
"description": "កម្មវិធីបើកលេង Minecraft កម្ពុជា - LONGVEK LAUNCHER",
"main": "main.js",
"scripts": {
"start": "electron .",
"build": "electron-builder --win --x64",
"build:win": "electron-builder --win --x64",
"build:linux": "electron-builder --linux AppImage deb tar.gz",
"build:linux:tar": "electron-builder --linux tar.gz",
"build:all": "electron-builder --win --linux",
"dist": "electron-builder"
},
"keywords": [
"minecraft",
"launcher",
"longvek",
"cambodia"
],
"author": "LONGVEK Team",
"license": "ISC",
"type": "commonjs",
"dependencies": {
"archiver": "^7.0.1",
"axios": "^1.7.9",
"discord-rpc": "^4.0.1",
"electron-updater": "^6.8.9",
"extract-zip": "^2.0.1",
"minecraft-launcher-core": "^3.18.2",
"msmc": "^3.1.5"
},
"devDependencies": {
"electron": "^31.7.7",
"electron-builder": "^24.13.3"
},
"build": {
"appId": "com.longvek.launcher",
"productName": "LONGVEK LAUNCHER",
"files": [
"main.js",
"preload.js",
"index.html",
"LONGVEKLAUNCHER.ico",
"package.json"
],
"publish": [
{
"provider": "github",
"owner": "zarxmcofficial",
"repo": "longveklauncher"
}
],
"directories": {
"output": "dist"
},
"win": {
"target": "nsis",
"icon": "LONGVEKLAUNCHER.ico"
},
"nsis": {
"oneClick": false,
"perMachine": false,
"allowToChangeInstallationDirectory": true,
"installerIcon": "LONGVEKLAUNCHER.ico",
"uninstallerIcon": "LONGVEKLAUNCHER.ico",
"installerHeaderIcon": "LONGVEKLAUNCHER.ico",
"createDesktopShortcut": true,
"createStartMenuShortcut": true,
"shortcutName": "LONGVEK LAUNCHER",
"artifactName": "LONGVEK-LAUNCHER-Setup-${version}.${ext}"
},
"linux": {
"target": [
"AppImage",
"deb",
"tar.gz"
],
"category": "Game",
"icon": "LONGVEKLAUNCHER.ico",
"synopsis": "កម្មវិធីបើកលេង Minecraft កម្ពុជា - LONGVEK LAUNCHER",
"description": "LONGVEK Launcher - High Performance Minecraft Client Engine with In-Game Cyber HUD, Cape Synchronization, and P2P Friends Worlds for Linux.",
"maintainer": "LONGVEK Team",
"desktop": {
"StartupNotify": "true",
"Encoding": "UTF-8"
}
}
}
}