{
"name": "longveklauncher",
"productName": "LONGVEK LAUNCHER",
"version": "1.0.5",
"description": "កម្មវិធីបើកលេង Minecraft កម្ពុជា - LONGVEK LAUNCHER",
"main": "main.js",
"scripts": {
"start": "electron .",
"build": "electron-builder --win --x64",
"dist": "electron-builder"
},
"keywords": [
"minecraft",
"launcher",
"longvek",
"cambodia"
],
"author": "LONGVEK Team",
"license": "ISC",
"dependencies": {
"axios": "^1.6.8",
"discord-rpc": "^4.0.9",
"electron-updater": "^6.1.8",
"extract-zip": "^2.0.1",
"minecraft-launcher-core": "^3.2.14",
"msmc": "^4.0.1"
},
"devDependencies": {
"electron": "^29.1.5",
"electron-builder": "^24.13.3"
},
"build": {
"appId": "com.longvek.launcher",
"productName": "LONGVEK LAUNCHER",
"publish": [
{
"provider": "github",
"owner": "zarxmcofficial",
"repo": "longveklauncher"
}
],
"directories": {
"output": "dist"
},
"win": {
"target": "nsis",
"icon": "LONGVEKLAUNCHER.ico"
},
"nsis": {
"oneClick": true,
"perMachine": false,
"allowToChangeInstallationDirectory": false,
"installerIcon": "LONGVEKLAUNCHER.ico",
"uninstallerIcon": "LONGVEKLAUNCHER.ico",
"installerHeaderIcon": "LONGVEKLAUNCHER.ico",
"createDesktopShortcut": true,
"createStartMenuShortcut": true,
"shortcutName": "LONGVEK LAUNCHER",
"artifactName": "LONGVEK LAUNCHER Setup ${version}.${ext}"
}
}
}